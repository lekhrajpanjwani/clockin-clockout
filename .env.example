# --- Frontend (Vite exposes only VITE_-prefixed vars to the browser bundle) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Netlify Functions (server-side only — NEVER prefix these with VITE_) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE=eyJhbGciOi...
# Only required if your project still uses the legacy shared HS256 JWT
# secret (Project Settings -> API -> JWT Settings -> JWT Secret). Current
# Supabase projects sign tokens asymmetrically (ES256) and are verified via
# their public JWKS endpoint instead — no secret needed. Leave unset if
# unsure; the backend only reads this when it actually encounters an HS256
# token. See docs/04-api-design.md.
JWT_SECRET=your-supabase-jwt-secret
