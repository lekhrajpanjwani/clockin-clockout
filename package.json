{
  "name": "clockin-clockout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "netlify functions:serve --port 9999",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "netlify:dev": "netlify dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "cross-env TZ=UTC vitest run && cross-env TZ=Asia/Kolkata vitest run && cross-env TZ=America/Los_Angeles vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:db": "vitest run tests/db"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@hookform/resolvers": "^3.9.0",
    "@netlify/functions": "^2.8.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@sentry/browser": "^11.18.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^11.5.6",
    "jose": "^5.9.6",
    "lucide-react": "^0.445.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^6.26.2",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@electric-sql/pglite": "^0.6.0",
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.7.0",
    "buffer-equal-constant-time": "file:./tools/buffer-equal-constant-time",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "netlify-cli": "^27.20.1",
    "postcss": "^8.4.47",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.7",
    "vite-plugin-pwa": "^0.21.2",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,md,json,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "buffer-equal-constant-time": "$buffer-equal-constant-time"
  }
}
